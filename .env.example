# Copy to .env for local dev. packages/config validates ALL of this at boot
# and refuses to start on any missing/malformed key (prompt.md §4).

# Runtime
NODE_ENV=development
APP_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Data (docker-compose.dev.yml defaults)
MONGODB_URI=mongodb://127.0.0.1:27017/inboxbondhu?replicaSet=rs0
REDIS_URL=redis://127.0.0.1:6379
REDIS_MAXMEMORY_POLICY=noeviction

# Auth — generate: openssl rand -base64 32
JWT_SECRET=dev-secret-change-me-0123456789abcdef
JWT_SECRET_PREVIOUS=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
MAX_CONCURRENT_SESSIONS=5
ARGON2_MEMORY_KIB=19456

# Encryption — CHANNEL_TOKEN_MASTER_KEY: openssl rand -base64 32
CHANNEL_TOKEN_MASTER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
CHANNEL_TOKEN_KEY_VERSION=1
PII_HASH_PEPPER=dev-pepper-change-me

# Meta (dev placeholders)
META_APP_ID=dev-app-id
META_APP_SECRET=dev-app-secret
META_VERIFY_TOKEN=dev-verify-token
META_API_VERSION=v21.0
META_MESSAGING_WINDOW_HOURS=24

# LLM
LLM_PROVIDER=openai
LLM_API_KEY=sk-dev-placeholder
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=9000
AI_TOTAL_DEADLINE_MS=15000
AI_CONFIDENCE_THRESHOLD=0.70
AI_DAILY_COST_CAP_MINOR=20000
AI_PLATFORM_DAILY_CAP_MINOR=500000
PROMPT_VERSION=v1

# Storage / Email (optional in dev)
SPACES_ENDPOINT=
SPACES_BUCKET=
SPACES_KEY=
SPACES_SECRET=
RESEND_API_KEY=
EMAIL_FROM="InboxBondhu <no-reply@inboxbondhu.me>"

# Observability
DD_API_KEY=
DD_SITE=datadoghq.com
LOG_LEVEL=info

# Business rules
DEFAULT_TIMEZONE=Asia/Dhaka
MAX_DISCOUNT_PERCENT=50
ABANDONED_ORDER_HOURS=24
STUCK_MESSAGE_SECONDS=60
RETENTION_DAYS=90
MAX_PENDING_INVITES=20
CSV_MAX_ROWS=5000
