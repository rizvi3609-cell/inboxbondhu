{
  "$jsonSchema": {
    "bsonType": "object",
    "properties": {
      "_id": {
        "bsonType": "string",
        "pattern": "^[0-9a-fA-F]{24}:\\d{4}$"
      },
      "workspaceId": {
        "bsonType": "objectId"
      },
      "year": {
        "bsonType": [
          "int",
          "long"
        ]
      },
      "seq": {
        "bsonType": [
          "int",
          "long"
        ],
        "minimum": 0
      },
      "updatedAt": {
        "bsonType": "date"
      }
    }
  }
}
