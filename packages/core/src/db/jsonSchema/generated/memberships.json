          },
          {
            "bsonType": "null"
          }
        ]
      },
      "joinedAt": {
        "bsonType": "date"
      },
      "removedAt": {
        "anyOf": [
          {
            "bsonType": "date"
          },
          {
            "bsonType": "null"
          }
        ]
      }
    }
  }
}
