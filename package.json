{
  "name": "inboxbondhu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "lint": "eslint .",
    "typecheck": "tsc -p packages/contracts/tsconfig.json && tsc -p packages/config/tsconfig.json && tsc -p packages/logger/tsconfig.json && tsc -p packages/integrations/tsconfig.json && tsc -p packages/core/tsconfig.json && tsc -p apps/api/tsconfig.json && tsc -p apps/worker/tsconfig.json && tsc -p apps/web/tsconfig.json",
    "test": "vitest run",
    "build": "pnpm typecheck",
    "seed": "tsx packages/core/src/db/seed.ts",
    "jsonschema:generate": "tsx packages/core/src/db/jsonSchema/generate.ts",
    "jsonschema:check": "tsx packages/core/src/db/jsonSchema/generate.ts --check",
    "build:web": "pnpm --filter @inboxbondhu/web build"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "bson": "6",
    "eslint": "^9.17.0",
    "mongodb-memory-server": "^10.1.2",
    "mongoose": "^8.9.5",
    "tsx": "^4.19.0",
    "turbo": "^2.3.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  }
}
